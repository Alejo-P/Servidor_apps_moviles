DB_NAME=database_name
DB_USER=database_user
DB_PASSWORD=database_password
DB_HOST=database_host
DB_URI=mysql+pymysql://database_user:database_password@database_host:3306/database_name

PYTHONUNBUFFERED=1
AUTHJWT_SECRET_KEY=secret_key
AUTHJWT_COOKIE_SECURE=False
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRES=1d
JWT_REFRESH_TOKEN_EXPIRES=3d
JWT_ACCESS_CSRF_COOKIE=True
JWT_REFRESH_CSRF_COOKIE=True
SECRET_KEY=secret_key
ENV=development

CLOUDINARY_CLOUD_NAME = "name_of_your_cloud"
CLOUDINARY_API_KEY = "your_api_key"
CLOUDINARY_API_SECRET = "your_api_secret"
CLOUDINARY_URL = "cloudinary://your_api_key:your_api_secret@name_of_your_cloud"

URL_FRONTEND = "Frontend_URL"
URL_BACKEND = "Backend_URL"
TIMEZONE="your_timezone"

MAIL_USERNAME="your_email@gmail.com"
MAIL_PASSWORD="your_email_password"
MAIL_FROM="your_email@gmail.com"
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME="Prueba de envío de correo"